#!/usr/bin/python3
"""OmaTablePlus helper launcher.

Makes sure the database drivers in requirements.lock are installed, exactly
and verified, in ~/.local/share/omatableplus/venv, then runs the helper server
(`python -m omatableplus`) from that venv. Only the standard library is used here.

The venv is rebuilt when the system Python's minor version or the lock
changes; a failed install leaves nothing behind.
"""

import hashlib
import json
import os
import shutil
import subprocess
import sys
import venv

HERE = os.path.dirname(os.path.realpath(__file__))
DATA = os.environ.get("OMATABLEPLUS_DATA") or os.path.join(
    os.environ.get("XDG_DATA_HOME") or os.path.expanduser("~/.local/share"), "omatableplus")
VENV = os.path.join(DATA, "venv")
PIP_TIMEOUT = 600
LOCK = os.environ.get("OMATABLEPLUS_LOCK") or os.path.join(HERE, "requirements.lock")


def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def stamp():
    with open(LOCK, "rb") as f:
        digest = hashlib.sha256(f.read()).hexdigest()
    return f"{sys.version_info.major}.{sys.version_info.minor} {digest}"


def fatal(message):
    emit({"event": "fatal", "code": "drivers", "message": message})
    sys.exit(1)


def ensure_venv():
    python = os.path.join(VENV, "bin", "python")
    want = stamp()
    try:
        with open(os.path.join(VENV, ".omatableplus-stamp")) as f:
            if f.read().strip() == want and os.path.exists(python):
                return python
    except OSError:
        pass
    os.makedirs(DATA, mode=0o700, exist_ok=True)
    tmp = VENV + ".new"
    shutil.rmtree(tmp, ignore_errors=True)
    emit({"event": "progress", "text": "Preparing database drivers…", "pct": 10})
    try:
        venv.create(tmp, with_pip=True, clear=True)
    except Exception as e:  # noqa: BLE001
        shutil.rmtree(tmp, ignore_errors=True)
        fatal(f"could not create {tmp}: {e}")
    emit({"event": "progress", "text": "Installing database drivers…", "pct": 40})
    pip = [os.path.join(tmp, "bin", "python"), "-m", "pip", "install", "--disable-pip-version-check",
           "--no-input", "--require-hashes", "--no-deps", "--only-binary", ":all:", "--timeout", "60", "--retries", "2", "-r", LOCK]
    try:
        r = subprocess.run(pip, capture_output=True, text=True, timeout=PIP_TIMEOUT)
    except subprocess.TimeoutExpired:
        shutil.rmtree(tmp, ignore_errors=True)
        fatal(f"installing drivers timed out after {PIP_TIMEOUT} s; check your network and try again")
    if r.returncode != 0:
        shutil.rmtree(tmp, ignore_errors=True)
        lines = [l for l in (r.stderr or r.stdout).splitlines() if l.strip()]
        fatal("installing drivers failed: " + " ".join(lines[-3:]))
    with open(os.path.join(tmp, ".omatableplus-stamp"), "w") as f:
        f.write(want + "\n")
    old = VENV + ".old"
    shutil.rmtree(old, ignore_errors=True)
    had_old = os.path.exists(VENV)
    if had_old:
        os.rename(VENV, old)
    os.rename(tmp, VENV)
    if had_old:
        shutil.rmtree(old, ignore_errors=True)
    emit({"event": "progress", "text": "Drivers ready", "pct": 100})
    return python


def migrate():
    """Move what OmaTable (this plugin's name before 1.6) left behind to the OmaTablePlus paths."""
    config = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "omatableplus")
    legacy = os.path.join(os.path.dirname(config), "omatable")
    if not os.environ.get("OMATABLEPLUS_CONFIG") and not os.path.exists(config) \
            and os.path.isfile(os.path.join(legacy, "connections.json")):
        try:
            os.rename(legacy, config)
        except OSError:
            pass
    # The old drivers cannot move (a venv records its own path); remove them only when the stamp shows they are ours.
    legacy = os.path.join(os.path.dirname(DATA), "omatable")
    if not os.environ.get("OMATABLEPLUS_DATA") and os.path.isfile(os.path.join(legacy, "venv", ".omatable-stamp")):
        shutil.rmtree(os.path.join(legacy, "venv"), ignore_errors=True)
        try:
            os.rmdir(legacy)
        except OSError:
            pass


def main():
    migrate()
    python = ensure_venv()
    # No __pycache__ in the plugin folder: the shell reloads a plugin whose files change, which closes the window.
    env = dict(os.environ, PYTHONPATH=HERE, PYTHONDONTWRITEBYTECODE="1")
    os.execve(python, [python, "-m", "omatableplus"], env)


if __name__ == "__main__":
    main()
