import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import qs.Commons
import qs.Commons as Commons
import qs.Ui as Ui

// Create a table: a name, a schema and a list of columns. The CREATE TABLE
// statement is generated by the helper and shown before it runs.
Popup {
  id: dlg

  property var helper: null
  property string sid: ""
  property string engine: ""
  property var schemas: []
  property string schema: ""
  property var columns: []
  property int revision: 0
  property string sql: ""
  property bool busy: false
  property string error: ""
  signal created(string schema, string table)

  readonly property bool mysql: engine === "mysql" || engine === "mariadb"
  readonly property var types: engine === "postgresql"
    ? ["serial", "bigserial", "integer", "bigint", "numeric(10,2)", "boolean", "text", "varchar(255)", "date", "timestamptz", "jsonb", "uuid", "bytea"]
    : mysql ? ["int AUTO_INCREMENT", "bigint AUTO_INCREMENT", "int", "bigint", "decimal(10,2)", "tinyint(1)", "varchar(255)", "text", "date", "datetime", "timestamp", "json", "blob"]
    : ["INTEGER", "REAL", "TEXT", "BLOB", "NUMERIC"]

  function show(schemaNames, preferred) {
    schemas = schemaNames
    schema = preferred && schemaNames.indexOf(preferred) >= 0 ? preferred
      : schemaNames.indexOf("public") >= 0 ? "public" : (schemaNames[0] || "")
    nameField.setText("")
    columns = [{ name: "id", type: types[0], nullable: false, default: "", pk: true }]
    revision++
    sql = ""
    error = ""
    busy = false
    open()
    nameField.focusInput()
    refresh()
  }

  function set(i, key, value) {
    columns[i][key] = value
    if (key === "pk" && value) columns[i].nullable = false
    revision++
    refresh()
  }
  function addColumn() {
    columns.push({ name: "", type: dlg.mysql ? "varchar(255)" : dlg.engine === "postgresql" ? "text" : "TEXT", nullable: true, default: "", pk: false })
    revision++
    focusNew.restart()
  }
  function removeColumn(i) { columns.splice(i, 1); revision++; refresh() }

  function params() {
    return { session: sid, schema: schema, table: nameField.text.trim(),
             columns: columns.map(function(c) { return { name: c.name.trim(), type: c.type.trim(), nullable: c.nullable, default: c.default, pk: c.pk } }) }
  }
  function refresh() { previewTimer.restart() }

  function create() {
    if (busy) return
    busy = true
    error = ""
    const p = params()
    helper.request("table.create", p, function(r, e) {
      busy = false
      if (e) { if (e.code !== "cancelled") error = e.message; return }
      close()
      created(p.schema, p.table)
    })
  }

  Timer {
    id: previewTimer
    interval: 250
    onTriggered: {
      if (!dlg.opened) return
      helper.request("table.create_preview", dlg.params(), function(r, e) {
        if (e) { dlg.sql = ""; dlg.error = nameField.text.trim() ? e.message : ""; return }
        dlg.error = ""
        dlg.sql = r.statements.join(";\n") + ";"
      })
    }
  }
  Timer { id: focusNew; interval: 50; onTriggered: { colList.positionViewAtEnd(); const it = colList.itemAtIndex(dlg.columns.length - 1); if (it) it.focusName() } }

  parent: Overlay.overlay
  anchors.centerIn: parent
  width: Math.min(parent ? parent.width - 60 : 760, 820)
  height: Math.min(parent ? parent.height - 60 : 640, 680)
  padding: 16
  modal: true
  focus: true
  closePolicy: busy ? Popup.NoAutoClose : Popup.CloseOnEscape
  background: Rectangle { color: Commons.Color.popups.background; border.color: Commons.Color.popups.border; border.width: 1 }

  component HeadText: Text {
    textFormat: Text.PlainText
    color: Commons.Color.muted
    font.family: Style.font.family
    font.pixelSize: Style.font.bodySmall
    font.bold: true
  }

  ColumnLayout {
    anchors.fill: parent
    spacing: 10

    Text {
      textFormat: Text.PlainText
      text: "New table"
      color: Commons.Color.foreground
      font.family: Style.font.family
      font.pixelSize: Style.font.body
      font.bold: true
    }
    RowLayout {
      Layout.fillWidth: true
      spacing: 10
      Field {
        id: nameField
        Layout.fillWidth: true
        label: "Table name"
        placeholder: "e.g. customers"
        onTextChanged: dlg.refresh()
      }
      ColumnLayout {
        visible: dlg.schemas.length > 1
        spacing: 4
        Text { textFormat: Text.PlainText; text: dlg.mysql ? "Database" : "Schema"; color: Commons.Color.muted; font.family: Style.font.family; font.pixelSize: Style.font.bodySmall }
        Ui.Dropdown {
          Layout.preferredWidth: 200
          showLabel: false
          options: dlg.schemas
          value: dlg.schema
          onChanged: function(v) { dlg.schema = v; dlg.refresh() }
        }
      }
    }

    RowLayout {
      Layout.fillWidth: true
      spacing: 6
      HeadText { Layout.preferredWidth: 34; text: "Key" }
      HeadText { Layout.preferredWidth: colList.wName; text: "Column" }
      HeadText { Layout.preferredWidth: colList.wType; text: "Type" }
      HeadText { Layout.preferredWidth: 84; text: "Null" }
      HeadText { Layout.fillWidth: true; text: "Default" }
      Item { implicitWidth: 30 }
    }
    ListView {
      id: colList
      Layout.fillWidth: true
      Layout.fillHeight: true
      Layout.minimumHeight: 120
      clip: true
      spacing: 4
      model: { dlg.revision; return dlg.columns.length }
      readonly property int wName: Math.max(120, width * 0.25)
      readonly property int wType: Math.max(140, width * 0.28)
      ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }
      delegate: RowLayout {
        id: colRow
        required property int index
        readonly property var col: { dlg.revision; return dlg.columns[index] || {} }
        function focusName() { nameCell.forceActiveFocus() }
        width: colList.width
        spacing: 6
        Ui.Button {
          Layout.preferredWidth: 34
          bordered: true
          selected: !!colRow.col.pk
          text: colRow.col.pk ? "PK" : "–"
          fontSize: Style.font.bodySmall
          tooltipText: "Part of the primary key"
          onClicked: dlg.set(colRow.index, "pk", !colRow.col.pk)
        }
        Ui.TextField {
          id: nameCell
          Layout.preferredWidth: colList.wName
          font.family: "monospace"
          font.pixelSize: Style.font.bodySmall
          placeholderText: "name"
          text: colRow.col.name || ""
          onTextEdited: { dlg.columns[colRow.index].name = text; dlg.refresh() }
        }
        Ui.TextField {
          id: typeCell
          Layout.preferredWidth: colList.wType - typeBtn.width - 2
          font.family: "monospace"
          font.pixelSize: Style.font.bodySmall
          placeholderText: "type"
          text: colRow.col.type || ""
          onTextEdited: { dlg.columns[colRow.index].type = text; dlg.refresh() }
        }
        Ui.Button {
          id: typeBtn
          Layout.leftMargin: -4
          text: "▾"
          tooltipText: "Common types"
          onClicked: {
            const p = typeBtn.mapToItem(Overlay.overlay, 0, typeBtn.height)
            typeMenu.row = colRow.index
            typeMenu.x = Math.min(p.x, Overlay.overlay.width - typeMenu.width - 4)
            typeMenu.y = Math.min(p.y, Overlay.overlay.height - typeMenu.implicitHeight - 4)
            typeMenu.open()
          }
        }
        Ui.Button {
          Layout.preferredWidth: 84
          bordered: true
          enabled: !colRow.col.pk
          fontSize: Style.font.bodySmall
          text: colRow.col.nullable ? "NULL" : "NOT NULL"
          onClicked: dlg.set(colRow.index, "nullable", !colRow.col.nullable)
        }
        Ui.TextField {
          Layout.fillWidth: true
          font.family: "monospace"
          font.pixelSize: Style.font.bodySmall
          placeholderText: "none"
          text: colRow.col.default || ""
          onTextEdited: { dlg.columns[colRow.index].default = text; dlg.refresh() }
        }
        Ui.Button {
          implicitWidth: 30
          text: "✕"
          enabled: dlg.columns.length > 1
          tooltipText: "Remove this column"
          onClicked: dlg.removeColumn(colRow.index)
        }
      }
    }
    RowLayout {
      Layout.fillWidth: true
      Ui.Button { bordered: true; text: "+ Column"; onClicked: dlg.addColumn() }
      Text {
        textFormat: Text.PlainText
        Layout.fillWidth: true
        text: "Defaults are SQL: 'text' needs quotes, now() does not"
        color: Commons.Color.muted
        elide: Text.ElideRight
        font.family: Style.font.family
        font.pixelSize: Style.font.bodySmall
      }
    }
    ScrollView {
      Layout.fillWidth: true
      Layout.preferredHeight: Math.min(sqlText.implicitHeight + 12, 150)
      visible: dlg.sql !== ""
      TextArea {
        id: sqlText
        readOnly: true
        selectByMouse: true
        text: dlg.sql
        color: Commons.Color.foreground
        font.family: "monospace"
        font.pixelSize: Style.font.bodySmall
        background: Rectangle { color: Qt.lighter(Commons.Color.background, 1.1); radius: 4 }
      }
    }
    Text {
      textFormat: Text.PlainText
      Layout.fillWidth: true
      visible: dlg.error !== ""
      text: dlg.error
      wrapMode: Text.Wrap
      color: Commons.Color.urgent
      font.family: "monospace"
      font.pixelSize: Style.font.bodySmall
    }
    RowLayout {
      Layout.fillWidth: true
      Item { Layout.fillWidth: true }
      Ui.Button { text: "Cancel"; enabled: !dlg.busy; onClicked: dlg.close() }
      Ui.Button {
        bordered: true
        foreground: Commons.Color.accent
        text: dlg.busy ? "Creating…" : "Create table"
        enabled: !dlg.busy && dlg.sql !== ""
        onClicked: dlg.create()
      }
    }
  }

  Popup {
    id: typeMenu
    property int row: -1
    parent: Overlay.overlay
    padding: 4
    width: 200
    background: Rectangle { color: Commons.Color.menu.background; border.color: Commons.Color.menu.border; border.width: 1 }
    Column {
      width: parent.width
      Repeater {
        model: dlg.types
        delegate: Ui.Button {
          required property string modelData
          width: typeMenu.width - 8
          leftAlign: true
          text: modelData
          fontFamily: "monospace"
          fontSize: Style.font.bodySmall
          onClicked: { typeMenu.close(); dlg.set(typeMenu.row, "type", modelData) }
        }
      }
    }
  }
}
